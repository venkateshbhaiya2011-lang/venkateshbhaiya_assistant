# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google reCAPTCHA v3 Configuration (Invisible/Background bot protection)
# RECAPTCHA_SITE_KEY: Public site key for Google reCAPTCHA v3 (passed to client)
RECAPTCHA_SITE_KEY=

# RECAPTCHA_SECRET_KEY: Server-side secret key used to verify reCAPTCHA tokens via Google's siteverify API.
# CRITICAL: This secret MUST remain on the server only. Never expose in client code, index.html, or VITE_ variables!
RECAPTCHA_SECRET_KEY=

# ADMIN_SECRET_KEY: Optional server-side master passkey for the VenkateshBhaiya Admin Monitoring Dashboard.
# Configure this in Google AI Studio Settings -> Secrets panel if you wish to unlock the admin dashboard
# via a secret key in addition to logging in with your authorized Google Account (venkateshbhaiya2011@gmail.com).
# CRITICAL: Never hardcode passwords or commit actual secrets to this file.
ADMIN_SECRET_KEY=
